@{
	ViewData["Title"] = "Access Denied";
}

<section class="breadcrumb-section">
	<h2 class="sr-only">Site Breadcrumb</h2>
	<div class="container">
		<div class="breadcrumb-contents">
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
					<li class="breadcrumb-item active">Access Denied</li>
				</ol>
			</nav>
		</div>
	</div>
</section>

<div class="page-section inner-page-sec-padding">
	<div class="container">
		<div class="row">
			<div class="col-12 text-center">
				<div class="error-section">
					<h1 class="error-title">Access Denied</h1>
					<p class="error-message">Sorry, you don't have permission to access this page.</p>
					<p>You need administrator privileges to access this resource.</p>
					<a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-4">Go to Home</a>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.error-section {
		padding: 40px 20px;
		text-align: center;
	}

	.error-title {
		font-size: 48px;
		color: #d9534f;
		margin-bottom: 20px;
	}

	.error-message {
		font-size: 18px;
		color: #666;
		margin-bottom: 10px;
	}
</style>



