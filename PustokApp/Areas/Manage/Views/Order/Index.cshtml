@using PustokApp.Models
@model List<Order>
@{
	int count = 0;
}

<div class="row">
	<div class="col-md-12">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1>Orders Management</h1>
		</div>

		@if (Model != null && Model.Count > 0)
		{
			<div class="table-responsive">
				<table class="table table-hover table-bordered">
					<thead class="table-light">
						<tr>
							<th style="width: 5%">#</th>
							<th style="width: 12%">Order ID</th>
							<th style="width: 12%">Customer</th>
							<th style="width: 12%">Date</th>
							<th style="width: 12%">Total</th>
							<th style="width: 10%">Status</th>
							<th style="width: 12%">Items</th>
							<th style="width: 25%">Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var order in Model)
						{
							count++;
							<tr>
								<td>@count</td>
								<td><strong>@order.Id.ToString().Substring(0, 8)</strong></td>
								<td>@(order.AppUser?.UserName ?? "Unknown")</td>
								<td>@order.CreatedDate.ToString("MMM dd, yyyy")</td>
								<td><strong>$@order.TotalPrice.ToString("F2")</strong></td>
								<td>
									@switch(order.Status)
									{
										case OrderStatus.Pending:
											<span class="badge bg-warning text-dark">Pending</span>
											break;
										case OrderStatus.Accepted:
											<span class="badge bg-success">Accepted</span>
											break;
										case OrderStatus.Rejected:
											<span class="badge bg-danger">Rejected</span>
											break;
									}
								</td>
								<td>
									<button class="btn btn-sm btn-info" type="button" data-bs-toggle="modal" data-bs-target="#itemsModal" onclick="showOrderItems('@order.Id.ToString()', '@order.AppUser?.UserName', @order.OrderItems.Count)">
										<i class="fas fa-eye"></i> View Items
									</button>
								</td>
								<td>
									@if (order.Status != OrderStatus.Accepted)
									{
										<form asp-action="AcceptOrder" asp-route-id="@order.Id" method="post" style="display:inline;">
											<button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Accept this order?')">
												<i class="fas fa-check"></i> Accept
											</button>
										</form>
									}
									@if (order.Status != OrderStatus.Rejected)
									{
										<form asp-action="RejectOrder" asp-route-id="@order.Id" method="post" style="display:inline;">
											<button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Reject this order?')">
												<i class="fas fa-times"></i> Reject
											</button>
										</form>
									}
									<form asp-action="DeleteOrder" asp-route-id="@order.Id" method="post" style="display:inline;">
										<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this order? This cannot be undone!')">
											<i class="fas fa-trash"></i> Delete
										</button>
									</form>
								</td>
							</tr>

							<!-- Hidden row for order items data -->
							<tr style="display:none;" id="items-row-@order.Id">
								<td colspan="8">
									<table class="table table-sm mb-0">
										<thead class="table-light">
											<tr>
												<th>Product Name</th>
												<th style="width: 10%">Quantity</th>
												<th style="width: 12%">Price</th>
												<th style="width: 12%">Total</th>
											</tr>
										</thead>
										<tbody>
											@if (order.OrderItems != null && order.OrderItems.Count > 0)
											{
												@foreach (var item in order.OrderItems)
												{
													var itemTotal = item.Count * item.Price;
													<tr>
														<td>@(item.Book?.Name ?? "Unknown")</td>
														<td>@item.Count</td>
														<td>$@item.Price.ToString("F2")</td>
														<td>$@itemTotal.ToString("F2")</td>
													</tr>
												}
											}
											else
											{
												<tr>
													<td colspan="4" class="text-center text-muted">No items in this order</td>
												</tr>
											}
										</tbody>
									</table>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<div class="alert alert-info" role="alert">
				<i class="fas fa-info-circle"></i> No orders found
			</div>
		}
	</div>
</div>

<!-- Items Modal -->
<div class="modal fade" id="itemsModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Order Items - <span id="modalOrderCustomer"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" id="modalOrderBody">
				<!-- Items will be loaded here -->
			</div>
		</div>
	</div>
</div>

@section Scripts
{
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>
		// Show success message if TempData exists
		@if (TempData["SuccessMessage"] != null)
		{
			<text>
				Swal.fire({
					title: 'Success!',
					text: '@TempData["SuccessMessage"]',
					icon: 'success',
					confirmButtonColor: '#28a745',
					timer: 3000
				});
			</text>
		}

		function showOrderItems(orderId, customer, itemCount) {
			// Get the hidden row with items
			const itemsRow = document.getElementById('items-row-' + orderId);
			if (itemsRow) {
				const itemsHTML = itemsRow.innerHTML;
				document.getElementById('modalOrderCustomer').textContent = customer;
				document.getElementById('modalOrderBody').innerHTML = itemsHTML;
			} else {
				document.getElementById('modalOrderBody').innerHTML = '<p class="text-danger">Error loading items</p>';
			}
		}
	</script>
}
