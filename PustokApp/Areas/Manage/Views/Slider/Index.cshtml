@using PustokApp.Models
@model List<Slider>
@{
    int count = 0;
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Sliders</h1>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Is Main</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slider in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>
                            <img src="~/assets/image/bg-images/@slider.ImageUrl" alt="Slider Image" style="width: 100px; object-fit: cover;" />
                        </td>
                        <td>@slider.Title</td>
                        <td>@slider.Description</td>
                        <td>@(slider.IsMain ? "Yes" : "No")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@slider.Id" class="btn btn-info btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@slider.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@slider.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
