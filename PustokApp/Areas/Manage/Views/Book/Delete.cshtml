@model PustokApp.Models.Book
@{
    ViewData["Title"] = "Delete Book";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Warning!</h4>
            <p>You are about to delete this book. This action cannot be undone.</p>
            <hr>
            <p class="mb-0">All associated images will also be permanently deleted from the server.</p>
        </div>

        <div class="card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Book Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>Author</th>
                            <td>@(Model.Author?.FullName ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Code</th>
                            <td>@Model.Code</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>$@Model.Price.ToString("F2")</td>
                        </tr>
                        <tr>
                            <th>Main Image</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                                {
                                    <img src="~/assets/image/products/@Model.MainImageUrl" alt="Main Photo" style="max-width: 150px; max-height: 150px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4">
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="fas fa-trash"></i> Delete This Book
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
