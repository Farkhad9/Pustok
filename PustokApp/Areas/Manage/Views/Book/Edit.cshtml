@model PustokApp.Models.Book
@{
    ViewData["Title"] = "Edit Book";
    var authors = ViewBag.Authors as List<Author>;
    var tags = ViewBag.Tags as List<Tag>;
}

<div class="row">
    <div class="col-md-10">
        <div class="mb-3">
            <h1>Edit Book</h1>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label asp-for="Name">Book Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter book name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AuthorId">Author</label>
                <select asp-for="AuthorId" class="form-control" required>
                    <option value="">-- Select an Author --</option>
                    @if (authors != null)
                    {
                        foreach (var author in authors)
                        {
                            <option value="@author.Id" selected="@(author.Id == Model.AuthorId)">@author.FullName</option>
                        }
                    }
                </select>
                <span asp-validation-for="AuthorId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TagIds">Tags</label>
                <select asp-for="TagIds" class="form-control" multiple>
                    @if (tags != null)
                    {
                        foreach (var tag in tags)
                        {
                            var isSelected = Model.BookTags?.Any(bt => bt.TagId == tag.Id) ?? false;
                            <option value="@tag.Id" selected="@isSelected">@tag.Name</option>
                        }
                    }
                </select>
                <small class="form-text text-muted">Hold CTRL (or CMD on Mac) to select multiple tags.</small>
                <span asp-validation-for="TagIds" class="text-danger"></span>
            </div>

            <div class="form-row mb-3">
                <div class="col-md-4 mb-3">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Enter price" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DiscountPercent">Discount Percent</label>
                    <input asp-for="DiscountPercent" type="number" step="0.01" class="form-control" placeholder="Enter discount %" required />
                    <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Code">Code</label>
                    <input asp-for="Code" class="form-control" placeholder="Enter product code" required />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter book description" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-row mb-3">
                <div class="col-md-4 mb-3">
                    <label asp-for="MainPhoto">Main Photo</label>
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <div class="mb-2">
                            <img src="~/assets/image/products/@Model.MainImageUrl" alt="Main Photo" style="max-width: 100px; max-height: 100px;" />
                        </div>
                    }
                    <input asp-for="MainPhoto" type="file" class="form-control-file" accept="image/*" />
                    <small class="form-text text-muted">Leave empty to keep current image.</small>
                    <span asp-validation-for="MainPhoto" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="HoverPhoto">Hover Photo</label>
                    @if (!string.IsNullOrEmpty(Model.HoverImageUrl))
                    {
                        <div class="mb-2">
                            <img src="~/assets/image/products/@Model.HoverImageUrl" alt="Hover Photo" style="max-width: 100px; max-height: 100px;" />
                        </div>
                    }
                    <input asp-for="HoverPhoto" type="file" class="form-control-file" accept="image/*" />
                    <small class="form-text text-muted">Leave empty to keep current image.</small>
                    <span asp-validation-for="HoverPhoto" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Files">Additional Images</label>
                    @if (Model.BookImages?.Count > 0)
                    {
                        <div class="mb-2">
                            <p><strong>Current Images:</strong></p>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                @foreach (var image in Model.BookImages)
                                {
                                    <div>
                                        <img src="~/assets/image/products/@image.ImageUrl" alt="Book Image" style="max-width: 80px; max-height: 80px;" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <input asp-for="Files" type="file" multiple class="form-control-file" accept="image/*" />
                    <small class="form-text text-muted">You can select multiple extra photos to add.</small>
                    <span asp-validation-for="Files" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row mb-3 mt-4">
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="InStock" class="form-check-input" />
                        <label asp-for="InStock" class="form-check-label">In Stock?</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label">Is Featured?</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="IsNew" class="form-check-input" />
                        <label asp-for="IsNew" class="form-check-label">Is New?</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Update</button>
            <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
