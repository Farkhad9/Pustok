@model PustokApp.Models.Book

<div class="modal-header">
    <h5 class="modal-title">Book Details</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <table class="table table-bordered">
        <tbody>
            <tr>
                <th>ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>Author</th>
                <td>@(Model.Author?.FullName ?? "N/A")</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>@Model.Code</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>$@Model.Price.ToString("F2")</td>
            </tr>
            <tr>
                <th>Discount (%)</th>
                <td>@Model.DiscountPercent%</td>
            </tr>
            <tr>
                <th>Final Price</th>
                <td>$@((Model.Price * (1 - Model.DiscountPercent / 100)).ToString("F2"))</td>
            </tr>
            <tr>
                <th>In Stock</th>
                <td>
                    @if (Model.InStock)
                    {
                        <span class="badge badge-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">No</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Is Featured</th>
                <td>
                    @if (Model.IsFeatured)
                    {
                        <span class="badge badge-info">Yes</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">No</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Is New</th>
                <td>
                    @if (Model.IsNew)
                    {
                        <span class="badge badge-warning">Yes</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">No</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Description</th>
                <td>@Model.Description</td>
            </tr>
            @if (Model.BookTags != null && Model.BookTags.Any())
            {
                <tr>
                    <th>Tags</th>
                    <td>
                        @foreach (var bookTag in Model.BookTags)
                        {
                            <span class="badge badge-primary">@bookTag.Tag.Name</span>
                        }
                    </td>
                </tr>
            }
            <tr>
                <th>Main Image</th>
                <td>
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <img src="~/assets/image/products/@Model.MainImageUrl" alt="Main Photo" style="max-width: 150px; max-height: 150px;" />
                    }
                    else
                    {
                        <span>No image</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Hover Image</th>
                <td>
                    @if (!string.IsNullOrEmpty(Model.HoverImageUrl))
                    {
                        <img src="~/assets/image/products/@Model.HoverImageUrl" alt="Hover Photo" style="max-width: 150px; max-height: 150px;" />
                    }
                    else
                    {
                        <span>No image</span>
                    }
                </td>
            </tr>
            @if (Model.BookImages != null && Model.BookImages.Any())
            {
                <tr>
                    <th>Additional Images</th>
                    <td>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                            @foreach (var image in Model.BookImages)
                            {
                                <div>
                                    <img src="~/assets/image/products/@image.ImageUrl" alt="Book Image" style="max-width: 100px; max-height: 100px;" />
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
</div>
