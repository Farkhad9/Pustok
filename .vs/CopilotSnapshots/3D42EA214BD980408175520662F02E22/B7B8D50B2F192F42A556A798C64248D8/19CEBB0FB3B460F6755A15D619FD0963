
@model CheckOutVm

<section class="breadcrumb-section">
	<h2 class="sr-only">Site Breadcrumb</h2>
	<div class="container">
		<div class="breadcrumb-contents">
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a href="index.html">Home</a></li>
					<li class="breadcrumb-item active">Checkout</li>
				</ol>
			</nav>
		</div>
	</div>
</section>
<main id="content" class="page-section inner-page-sec-padding-bottom space-db--20">
	<div class="container">
		<h1 class="quick-title">Checkout</h1>
		<div class="row row-40">
			<!-- Left Column: Checkout Form -->
			<div class="col-lg-7">
				<div class="checkout-form">
					<div id="quick-login">
						<form id="checkout-form" asp-action="Checkout" method="post">
							<div class="quick-login-form">
								<p>
									If you have shopped with us before, please enter your details in the
									boxes below. If you are a new
									customer
									please
									proceed to the Billing & Shipping section.
								</p>
								<div class="form-group">
									<label asp-for="@Model.OrderVm.Address" ></label>
									<input asp-for="@Model.OrderVm.Address" placeholder="">
									<span asp-validation-for="@Model.OrderVm.Address" class="text-danger"></span>
								</div>
								<div class="form-group">
									<label asp-for="@Model.OrderVm.TownCity"></label>
									<input asp-for="@Model.OrderVm.TownCity" placeholder="">
									<span asp-validation-for="@Model.OrderVm.TownCity" class="text-danger"></span>
								</div>
								<div class="form-group">
									<label asp-for="@Model.OrderVm.ZipCode"></label>
									<input asp-for="@Model.OrderVm.ZipCode" placeholder="">
									<span asp-validation-for="@Model.OrderVm.ZipCode" class="text-danger"></span>
								</div>
								<div class="form-group">
									<label asp-for="@Model.OrderVm.State"></label>
									<input asp-for="@Model.OrderVm.State" placeholder="">
									<span asp-validation-for="@Model.OrderVm.State" class="text-danger"></span>
								</div>
								<div class="form-group">
									<div class="d-flex align-items-center flex-wrap">
										<a href="#" class="btn btn-outlined me-3">Login</a>
										<div class="d-inline-flex align-items-center">
											<input type="checkbox" id="accept_terms" class="mb-0 mx-1">
											<label for="accept_terms" class="mb-0">
												I've read and accept
												the terms &amp; conditions
											</label>
										</div>
									</div>
									<p>
										<a href="javascript:" class="pass-lost mt-3">
											Lost your
											password?
										</a>
									</p>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>

			<!-- Right Column: Your Order -->
			<div class="col-lg-5">
				<div class="checkout-cart-total">
					<h2 class="checkout-title">YOUR ORDER</h2>
					<h4>Product <span>Total</span></h4>
					<ul>
						@foreach (var item in Model.CheckOutItemVms)
						{
							<li>
								<span class="left">@item.Name X @item.Count</span>
								<span class="right">$@(item.Price*item.Count)</span>
							</li>
						}
					</ul>
					<p>Sub Total <span>$@(Model.CheckOutItemVms.Sum(i => i.Price * i.Count))</span></p>
					<p>Shipping Fee <span>$00.00</span></p>
					<h4>Grand Total <span>$@(Model.CheckOutItemVms.Sum(i => i.Price * i.Count))</span></h4>

					<button form="checkout-form" class="place-order w-100">Place order</button>
				</div>
			</div>
		</div>
	</div>
</main>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			// Prevent form submission if validation fails
			const form = document.getElementById('checkout-form');

			form.addEventListener('submit', function (e) {
				// Address validation
				const address = document.getElementById('OrderVm_Address');
				const townCity = document.getElementById('OrderVm_TownCity');
				const zipCode = document.getElementById('OrderVm_ZipCode');
				const state = document.getElementById('OrderVm_State');
				const acceptTerms = document.getElementById('accept_terms');

				let isValid = true;

				// Check if fields are empty
				if (!address.value.trim()) {
					address.classList.add('is-invalid');
					isValid = false;
				} else {
					address.classList.remove('is-invalid');
				}

				if (!townCity.value.trim()) {
					townCity.classList.add('is-invalid');
					isValid = false;
				} else {
					townCity.classList.remove('is-invalid');
				}

				if (!zipCode.value.trim()) {
					zipCode.classList.add('is-invalid');
					isValid = false;
				} else {
					zipCode.classList.remove('is-invalid');
				}

				if (!state.value.trim()) {
					state.classList.add('is-invalid');
					isValid = false;
				} else {
					state.classList.remove('is-invalid');
				}

				if (!acceptTerms.checked) {
					acceptTerms.classList.add('is-invalid');
					isValid = false;
				} else {
					acceptTerms.classList.remove('is-invalid');
				}

				if (!isValid) {
					e.preventDefault();
					alert('Please fill in all required fields and accept the terms & conditions');
				}
			});
		});
	</script>
}
