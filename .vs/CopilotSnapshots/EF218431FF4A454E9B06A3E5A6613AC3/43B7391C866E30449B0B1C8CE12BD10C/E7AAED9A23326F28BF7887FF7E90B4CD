@model PustokApp.Models.Book
@{
    ViewData["Title"] = "Create Book";
    var authors = ViewBag.Authors as List<Author>;
}

<div class="row">
    <div class="col-md-10">
        <div class="mb-3">
            <h1>Create Book</h1>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="form-group mb-3">
                <label asp-for="Name">Book Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter book name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AuthorId">Author</label>
                <select asp-for="AuthorId" class="form-control" required>
                    <option value="">-- Select an Author --</option>
                    @if (authors != null)
                    {
                        foreach (var author in authors)
                        {
                            <option value="@author.Id">@author.FullName</option>
                        }
                    }
                </select>
                <span asp-validation-for="AuthorId" class="text-danger"></span>
            </div>

            <div class="form-row mb-3">
                <div class="col-md-4 mb-3">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Enter price" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DiscountPercent">Discount Percent</label>
                    <input asp-for="DiscountPercent" type="number" step="0.01" class="form-control" placeholder="Enter discount %" required />
                    <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Code">Code</label>
                    <input asp-for="Code" class="form-control" placeholder="Enter product code" required />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter book description" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-row mb-3">
                <div class="col-md-4 mb-3">
                    <label asp-for="MainPhoto">Main Photo (Required)</label>
                    <input asp-for="MainPhoto" type="file" class="form-control-file" accept="image/*" required />
                    <span asp-validation-for="MainPhoto" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="HoverPhoto">Hover Photo (Required)</label>
                    <input asp-for="HoverPhoto" type="file" class="form-control-file" accept="image/*" required />
                    <span asp-validation-for="HoverPhoto" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Files">Additional Images</label>
                    <input asp-for="Files" type="file" multiple class="form-control-file" accept="image/*" />
                    <small class="form-text text-muted">You can select multiple extra photos.</small>
                    <span asp-validation-for="Files" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row mb-3 mt-4">
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="InStock" class="form-check-input" checked />
                        <label asp-for="InStock" class="form-check-label">In Stock?</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label">Is Featured?</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="IsNew" class="form-check-input" />
                        <label asp-for="IsNew" class="form-check-label">Is New?</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Create</button>
            <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
