@using PustokApp.Models
@model List<Author>
@{
    int count = 0;
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Authors</h1>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var author in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@author.FullName</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-info btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-danger btn-sm deleteAuthor">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts
{
    <script>
        $(document).ready(function () {
            $(".deleteAuthor").click(function (e) {
                e.preventDefault();
                var url = $(this).attr("href");
                Swal.fire({
                    title: "Are you sure?",
                    text: "This author will be permanently deleted!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, delete",
                    cancelButtonText: "Cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
						var url = $(this).attr("href");
                        $.ajax({
                            url: url,
                            type: "POST",
                            success: function () {
                                Swal.fire("Deleted!", "The author has been deleted.", "success").then(() => {
                                    location.reload();
                                });
                            },
                            error: function () {
                                Swal.fire("Error!", "An error occurred while deleting the author.", "error");
                            }
						});
                    }
                    else if (result.dismiss === Swal.DismissReason.cancel) {
						Swal.fire("Cancelled", "The author is safe.", "info");
                    }
                });
            });
        });
    </script>
}