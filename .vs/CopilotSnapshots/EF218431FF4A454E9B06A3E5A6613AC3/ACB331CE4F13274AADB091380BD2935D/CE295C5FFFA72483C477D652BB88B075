@{
    ViewData["Title"] = "Create Author";
}

<div class="row">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Create Author</h1>
        </div>

        <form action="/Manage/Author/Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="FullName">Full Name</label>
                <input type="text" class="form-control" id="FullName" name="FullName" placeholder="Enter author's full name" required>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
            <a href="/Manage/Author/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
