using Microsoft.EntityFrameworkCore;
using PustokApp.Data;
using PustokApp.ViewModels;
using System.Text.Json;

namespace PustokApp.Services
{
    public class LayoutService(AppDbContext context, IHttpContextAccessor httpContextAccessor)
    {
        public Dictionary<string, string> GetSettings()
        {
            return context.Settings.ToDictionary(s => s.Key, s => s.Value);
        }
        public List<BasketItemVm> GetBasketItems()
        {
            List<BasketItemVm> basketItems = new List<BasketItemVm>();

            // Если пользователь залогинен - берём товары из БД
            if (httpContextAccessor.HttpContext.User.Identity.IsAuthenticated)
            {
                var user = context.Users
                    .Include(u => u.BasketItems)
                    .ThenInclude(bi => bi.Book)
                    .FirstOrDefault(u => u.UserName == httpContextAccessor.HttpContext.User.Identity.Name);

                if (user != null)
                {
                    foreach (var userbasketItem in user.BasketItems)
                    {
                        basketItems.Add(new BasketItemVm
                        {
                            BookId = userbasketItem.BookId,
                            Name = userbasketItem.Book.Name,
                            Price = userbasketItem.Book.DiscountPercent > 0 ? userbasketItem.Book.Price - (userbasketItem.Book.Price * userbasketItem.Book.DiscountPercent / 100) : userbasketItem.Book.Price,
                            Count = userbasketItem.Count,
                            MainImageUrl = userbasketItem.Book.MainImageUrl
                        });
                    }
                }
            }
            else
            {
                // Если не залогинен - берём из cookie
                var basketStr = httpContextAccessor.HttpContext.Request.Cookies["basket"];
                if (!string.IsNullOrEmpty(basketStr))
                {
                    basketItems = JsonSerializer.Deserialize<List<BasketItemVm>>(basketStr);
                }
            }

            return basketItems;
        }
    }
}
