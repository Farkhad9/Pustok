@model PustokApp.ViewModels.UserVm.RegisterVm
@{
    ViewData["Title"] = "Register";
}

<section class="breadcrumb-section">
	<h2 class="sr-only">Site Breadcrumb</h2>
	<div class="container">
		<div class="breadcrumb-contents">
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
					<li class="breadcrumb-item active">Register</li>
				</ol>
			</nav>
		</div>
	</div>
</section>

<!--=============================================
=            Registration page content         =
=============================================-->
<main class="page-section inner-page-sec-padding-bottom">
	<div class="container">
		<div class="row">
			<div class="col-sm-12 col-md-12 col-xs-12 col-lg-6 offset-lg-3 mb--30">
				<!-- Registration Form -->
				<form asp-action="Register" asp-controller="Author" asp-area="Manage" method="post">
					<div class="login-form">
						<h4 class="login-title">Create New Account</h4>
						<p><span class="font-weight-bold">Register as a new user</span></p>
						
						@if (ViewBag.ErrorMessage != null)
						{
							<div class="alert alert-danger" role="alert">
								@ViewBag.ErrorMessage
							</div>
						}
						
						<div class="row">
							<div class="col-md-12 col-12 mb--15">
								<label asp-for="FullName">Full Name</label>
								<input asp-for="FullName" class="mb-0 form-control" placeholder="Enter your full name">
								<span asp-validation-for="FullName" class="text-danger"></span>
							</div>
							
							<div class="col-12 mb--20">
								<label asp-for="Username">Username</label>
								<input asp-for="Username" class="mb-0 form-control" placeholder="Enter your username">
								<span asp-validation-for="Username" class="text-danger"></span>
							</div>
							
							<div class="col-12 mb--20">
								<label asp-for="Email">Email</label>
								<input asp-for="Email" class="mb-0 form-control" type="email" placeholder="Enter your email address">
								<span asp-validation-for="Email" class="text-danger"></span>
							</div>
							
							<div class="col-lg-6 mb--20">
								<label asp-for="Password">Password</label>
								<input asp-for="Password" class="mb-0 form-control" type="password" placeholder="Enter your password">
								<span asp-validation-for="Password" class="text-danger"></span>
							</div>
							
							<div class="col-lg-6 mb--20">
								<label asp-for="ConfirmPassword">Confirm Password</label>
								<input asp-for="ConfirmPassword" class="mb-0 form-control" type="password" placeholder="Repeat your password">
								<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
							</div>
							
							<div class="col-md-12">
								<button type="submit" class="btn btn-outlined">Register</button>
							</div>
							
							<div class="col-md-12 mt-3">
								<p>Already have an account? <a asp-action="Login" asp-controller="AdminAccount" asp-area="Manage">Login here</a></p>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</main>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}