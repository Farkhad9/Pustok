@model PustokApp.ViewModels.UserVm.LoginVm
@{
    ViewData["Title"] = "Login";
}

<section class="breadcrumb-section">
	<h2 class="sr-only">Site Breadcrumb</h2>
	<div class="container">
		<div class="breadcrumb-contents">
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
					<li class="breadcrumb-item active">Login</li>
				</ol>
			</nav>
		</div>
	</div>
</section>

<!--=============================================
=            Login page content                =
=============================================-->
<main class="page-section inner-page-sec-padding-bottom">
	<div class="container">
		<div class="row">
			<div class="col-sm-12 col-md-12 col-xs-12 col-lg-6 offset-lg-3 mb--30">
				<!-- Login Form -->
				<form asp-action="Login" asp-controller="Account" method="post">
					<div class="login-form">
						<h4 class="login-title">Customer Login</h4>
						<p><span class="font-weight-bold">I am a returning customer</span></p>
						
						@if (!ViewData.ModelState.IsValid)
						{
							<div class="alert alert-danger" role="alert">
								<ul class="mb-0">
									@foreach (var modelState in ViewData.ModelState.Values)
									{
										@foreach (var error in modelState.Errors)
										{
											<li>@error.ErrorMessage</li>
										}
									}
								</ul>
							</div>
						}
						
						<div class="row">
							<div class="col-md-12 col-12 mb--15">
								<label asp-for="Username">Username</label>
								<input asp-for="Username" class="mb-0 form-control" placeholder="Enter your username">
								<span asp-validation-for="Username" class="text-danger small"></span>
							</div>
							
							<div class="col-12 mb--20">
								<label asp-for="Password">Password</label>
								<input asp-for="Password" class="mb-0 form-control" type="password" placeholder="Enter your password">
								<span asp-validation-for="Password" class="text-danger small"></span>
							</div>

							<div class="col-12 mb--20">
								<div class="form-check" style="display: flex; align-items: center; gap: 8px;">
									<input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" style="width: 18px; height: 18px; margin: 0; cursor: pointer; accent-color: #667eea;">
									<label class="form-check-label" for="rememberMe" style="color: #333; font-size: 14px; cursor: pointer; margin: 0; user-select: none;">Remember me</label>
								</div>
							</div>
							
							<div class="col-md-12">
								<button type="submit" class="btn btn-outlined">Login</button>
							</div>
							
							<div class="col-md-12 mt-3">
								<p>Don't have an account? <a asp-action="Register" asp-controller="Account">Register here</a></p>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</main>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
